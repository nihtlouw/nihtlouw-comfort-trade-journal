# ============================================================================
# 1. CORE DATABASE & AUTHENTICATION (Optional — omit for 100% browser-only mode)
# ============================================================================
DATABASE_URL=postgresql://user:password@host/database?sslmode=require
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-with-a-long-random-secret-at-least-32-characters
# Public HTTPS origin with no trailing slash (e.g. https://bloomjournal.app)
BETTER_AUTH_URL=http://localhost:3000

# ============================================================================
# 2. SAAS FREEMIUM + CLOUD SYNC PRO MODE
# ============================================================================
# When true:
# - Visitors open directly in 100% Free Local Mode (zero signup wall, $0 server cost)
# - Self-service signup is enabled at /?auth=1
# - Cloud Sync (PC <-> Android), Cloud Chartbook & Strategy PDFs require active Pro
# - Cassette MP3 audio stays fast & device-local in IndexedDB
BLOOM_SAAS_MODE=true

# Legacy private self-hosted flag (ignored when BLOOM_SAAS_MODE=true)
BLOOM_ALLOW_SIGNUP=false

# ============================================================================
# 3. 1-CLICK GOOGLE SIGN-IN (Optional — appears automatically when configured)
# ============================================================================
# Callback URL in Google Cloud Console: {BETTER_AUTH_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ============================================================================
# 4. DUAL PAYMENT GATEWAYS (Indonesia IDR + Global USD)
# ============================================================================
# A) Indonesia — Midtrans Snap (QRIS, BCA/Mandiri/BNI/BRI VA, GoPay, ShopeePay)
# Webhook Notification URL: {BETTER_AUTH_URL}/api/billing/webhooks/midtrans
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_IS_PRODUCTION=false
BLOOM_PRO_IDR_MONTHLY=49000
BLOOM_PRO_IDR_YEARLY=469000

# B) International — Lemon Squeezy (Global Credit/Debit Cards, Apple Pay, PayPal)
# Webhook URL: {BETTER_AUTH_URL}/api/billing/webhooks/lemonsqueezy
LEMONSQUEEZY_API_KEY=
LEMONSQUEEZY_STORE_ID=
LEMONSQUEEZY_VARIANT_MONTHLY_ID=
LEMONSQUEEZY_VARIANT_YEARLY_ID=
LEMONSQUEEZY_WEBHOOK_SECRET=
BLOOM_PRO_USD_MONTHLY=6
BLOOM_PRO_USD_YEARLY=58

# ============================================================================
# 5. CLOUDFLARE R2 / S3 OBJECT STORAGE (Recommended for $0 Egress Pro Storage)
# ============================================================================
# When set, chart screenshots (auto-compressed WebP) & strategy PDFs are stored
# in Cloudflare R2 / S3 instead of PostgreSQL rows. Falls back to Postgres if blank.
R2_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
R2_BUCKET=bloom-journal-assets
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_REGION=auto
