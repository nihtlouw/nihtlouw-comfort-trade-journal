# Optional. Without DATABASE_URL, Bloom runs as a browser-only journal.
DATABASE_URL=postgresql://user:password@host/database?sslmode=require
# Required together with DATABASE_URL; generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-with-a-long-random-secret-at-least-32-characters
# The exact public HTTPS origin, with no trailing path.
BETTER_AUTH_URL=http://localhost:3000

# Explicit opt-in; disable after creating your accounts to prevent open sign-ups.
BLOOM_ALLOW_SIGNUP=false
